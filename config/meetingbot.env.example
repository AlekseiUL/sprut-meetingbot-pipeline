# Copy this file to config/meetingbot.env and fill in local values.
# Never commit config/meetingbot.env.

# Runtime paths. Defaults work when running from this repository.
MEETINGBOT_BACKEND_URL=http://127.0.0.1:3001
MEETINGBOT_BACKEND_AUTO_START=1
MEETINGBOT_BACKEND_READY_TIMEOUT=120
MEETINGBOT_BACKEND_BUILD_TIMEOUT=900
MEETINGBOT_COMPOSE_PROJECT=sprut-meetingbot

# Bot identity inside Google Meet.
MEETINGBOT_DISPLAY_NAME=MeetingBot
MEETINGBOT_TEAM_ID=local-meetingbot
MEETINGBOT_USER_ID=local-user
MEETINGBOT_JOIN_TOKEN=local-recording

# Recording monitor.
MEETINGBOT_RECORDING_STABLE_SECONDS=90
MEETINGBOT_DELIVER_TO=local

# ASR/diarization.
MEETINGBOT_TRANSCRIBE_LANGUAGE=ru
MEETINGBOT_WHISPER_MODEL=mlx-community/whisper-medium-mlx
MEETINGBOT_WHISPER_PYTHON=$HOME/.sprut-meetingbot/whisper-env/bin/python3
MEETINGBOT_DIARIZATION_ATTEMPTS=3
MEETINGBOT_DIARIZATION_TIMEOUT=7200
MEETINGBOT_AUDIO_CLEANUP=1
MEETINGBOT_TRIM_TRAILING_SILENCE=1
MEETINGBOT_TRAILING_SILENCE_SECONDS=12
MEETINGBOT_SILENCE_NOISE=-35dB

# Required for pyannote/speaker-diarization-3.1.
# Create a Hugging Face token and accept the model terms in your HF account.
HF_TOKEN=hf_your_token_here

# Optional: Hermes CLI notification/LLM analysis integration.
# Leave MEETINGBOT_DELIVER_TO=local if you do not use Hermes.
HERMES_BIN=hermes
MEETINGBOT_ANALYSIS_PROFILE=default
