NODE_ENV=development
PORT=3001

# Local recorder mode for MeetingBot pipeline.
REDIS_CONSUMER_ENABLED=false
AUTH_BASE_URL_V2=http://localhost:8081/v2
MAX_RECORDING_DURATION_MINUTES=180
MEETING_INACTIVITY_MINUTES=3
INACTIVITY_DETECTION_START_DELAY_MINUTES=0
MEETING_SILENCE_THRESHOLD=1
MEETING_PARTICIPANT_INACTIVITY_ENABLED=false
JOIN_WAIT_TIME_MINUTES=15
RETRY_COUNT=2

# The browser recorder writes MediaRecorder chunks. The host monitor can convert
# this artifact to WAV before Whisper/pyannote processing.
UPLOADER_FILE_EXTENSION=.webm
UPLOADER_TYPE=local
STORAGE_PROVIDER=s3
NOTIFY_WEBHOOK_ENABLED=false

# Keep optional upstream settings empty in local-only mode.
GCP_ACCESS_KEY_ID=
GCP_SECRET_ACCESS_KEY=
GCP_MISC_BUCKET=
GCP_MISC_BUCKET_FOLDER=meeting-bot
GCP_DEFAULT_REGION=
SCREENAPP_BACKEND_SERVICE_API_KEY=
